// dml.config.dml — DML 写的项目配置（示例）
// 兑现"配置文件也是 DML 写的"：用 DML 的属性/序列/命名空间描述配置，
// 而非 YAML/JSON/TOML。由 @tsdml/compiler（Rust native）解析。
// @config {
//   @schema: "https://raw.githubusercontent.com/../dml.schema.dml"

// }
project {
  @name: "dml-framework"
  @version: "0.0.0"
  @type: "monorepo"

  packageManager: "pnpm@11.10.0"

  include: [
    "packages/*",
    "examples/*"
  ]

  tasks {
    build: "pnpm -r --filter './packages/*' run build"
    test: "pnpm -r --filter './packages/*' run test"
    "build:napi": "pnpm --filter @tsdml/compiler run build"
  }

  registry {
    @scope: "@dml"
    aliases: {
      reactivity: "@dml/reactivity"
      runtime: "@dml/runtime-core"
      dom: "@dml/runtime-dom"
      test: "@dml/runtime-test"
      umbrella: "dml"
    }
  }

  vite {
    enable: true
    plugins: [ "@dml/vite-plugin" ]
  }
}