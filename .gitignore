*.old

# binaries — never commit these, they are rebuilt per platform
*.exe
*.dll
*.so
*.dylib

# packaging / staging
.vsix-stage/

# vite-plugin-inspect debug output
.vite-inspect/

# VS Code extension integration suite: esbuild output lands next to the specs
# (the VS Code test runner loads the .js in place)
editors/vscode-tsdml/test/integration/suite/*.spec.js
editors/vscode-tsdml/test/integration/suite/index.js

# VS Code integration test: downloads a whole editor instance (~12k files)
.vscode-test/

# local scratch dirs
.isoext2/
isoext2/

# editor
.vscode/
.idea/
.DS_Store

# logs
*.log
npm-debug.log*
.local/

# temp files
*.tmp
*.bak
test-*.mjs
test-*.js
