{
  "name": "dml",
  "version": "0.0.0",
  "description": "DML umbrella package: framework surface for users. Wires @dml/reactivity + @dml/runtime-dom, exposes e()/mount/createApp used by TSDML-compiled code, plus DML schema types.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dml/reactivity": "workspace:*",
    "@dml/runtime-dom": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
