{
  "name": "@tsdml/vite",
  "version": "0.0.0",
  "description": "Vite plugin for TSDML: transforms .tsdml files (TS + DML templates) into e() runtime calls, seamlessly integrated with the Vite build.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tsdml/compiler": "workspace:*",
    "@tsdml/transform": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "tsdown": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
