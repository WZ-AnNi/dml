{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "paths": {
      "@tsdml/transform": ["../../packages/transform/src/index.ts"],
      "@tsdml/language-service": ["../../packages/language-service/src/index.ts"]
    }
  },
  "include": ["src"]
}
